<view class="wrap">

  <!-- 用户卡 -->
  <view class="cardp">
    <view class="urow">
      <view class="uava">🌳</view>
      <view class="un">
        <text class="un-b">{{user.name}}</text>
        <text class="un-s">无名树家庭会员 · 第 {{user.vipYear}} 年</text>
      </view>
      <text class="vip">🍂 会员</text>
    </view>
  </view>

  <!-- 课时包 -->
  <view class="cardp gap">
    <view class="rowl">
      <view class="ric eg">🎫</view>
      <view class="rt">
        <text class="rt-b">秋季家庭课时包</text>
        <text class="rt-s">{{user.hoursExpire}} 到期</text>
      </view>
      <text class="pill ps" hover-class="hv" bindtap="onRenew">可续费</text>
    </view>
    <view class="seats">
      <text class="seats-n">剩余 {{user.hoursLeft}} / {{user.hoursTotal}} 课时</text>
      <view class="bar"><view class="bar-i" style="width: {{hoursPercent}}%;"></view></view>
    </view>
  </view>

  <!-- 我的报名（报名成功后出现在这里） -->
  <block wx:if="{{regs.length}}">
    <view class="sec"><text class="sec-t">📋 我的报名</text></view>
    <view class="cardp regcard">
      <view wx:for="{{regs}}" wx:key="id" class="reg-row">
        <view class="reg-mid">
          <text class="reg-t">{{item.title}}</text>
          <text class="reg-s">{{item.kids}} · {{item.time}}</text>
        </view>
        <text class="pill {{item.waitlist ? 'pb' : 'pg'}}">{{item.waitlist ? '候补中' : '已报名'}}</text>
      </view>
    </view>
  </block>

  <!-- 我的孩子 -->
  <view class="sec"><text class="sec-t">🧒 我的孩子</text></view>
  <view class="cardp tight">
    <view wx:for="{{children}}" wx:key="id" class="rowl">
      <view class="ric {{index === 0 ? 'ek' : 'eb'}}">{{item.emoji}}</view>
      <view class="rt">
        <text class="rt-b">{{item.name}} · {{item.age}} 岁</text>
        <text class="rt-s">{{item.allergy}} · 紧急联系人：{{item.emergency}}</text>
      </view>
      <text class="authok" wx:if="{{item.photoAuth}}">✓ 照片已授权</text>
    </view>
  </view>

  <!-- 更多 -->
  <view class="sec"><text class="sec-t">✨ 更多</text></view>
  <view class="cardp tight">
    <view wx:for="{{moreRows}}" wx:key="label" class="rowl" hover-class="hv" bindtap="onRow">
      <view class="ric ri-{{item.bg}}">{{item.icon}}</view>
      <view class="rt"><text class="rt-b">{{item.label}}</text></view>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="foot">无名树小程序 · v0.2 原型工程 · 数据均为虚构</view>

</view>
